flowchart TD
  User["User or CI request"]
  CLI["Typer CLI"]
  API["FastAPI"]
  Router{"IntentRouterAgent"}

  User --> CLI
  User --> API
  CLI --> Router
  API --> Router

  subgraph Inputs["Knowledge inputs"]
    BRD["BRD documents"]
    SRS["SRS documents"]
    Design["Design documents"]
    InterfaceDocs["Interface and API specs"]
    ProtocolDocs["Protocol standards and mappings"]
    ExistingTests["Existing tests and defects"]
  end

  subgraph Ingestion["Ingestion and extraction"]
    Resolver["DocumentResolverAgent"]
    Parser["PyMuPDF, pdfplumber, python-docx, optional OCR"]
    Chunker["Domain-aware chunking"]
    RuleExtract["Deterministic extractors"]
    TableExtract["Table extraction"]
    LLMExtract["Optional structured LLM extraction"]
    DomainAnalyzer["DomainAnalyzerAgent"]
  end

  Router --> Resolver
  Inputs --> Resolver
  Resolver --> Parser --> Chunker
  Chunker --> RuleExtract
  Chunker --> TableExtract
  Chunker --> LLMExtract
  RuleExtract --> DomainAnalyzer
  TableExtract --> DomainAnalyzer
  LLMExtract --> DomainAnalyzer

  subgraph Knowledge["Knowledge and retrieval layer"]
    SQLite["SQLite metadata registry now"]
    Postgres["PostgreSQL later"]
    FTS["SQLite FTS5 BM25 now"]
    OpenSearch["OpenSearch BM25 later"]
    Chroma["Chroma local vectors"]
    Weaviate["Weaviate optional vectors"]
    Neo4j["Neo4j knowledge graph"]
    Objects["Local object artifacts"]
  end

  Chunker --> Objects
  Chunker --> SQLite
  RuleExtract --> SQLite
  TableExtract --> SQLite
  DomainAnalyzer --> SQLite
  SQLite -. future migration .-> Postgres
  Chunker --> FTS
  FTS -. future migration .-> OpenSearch
  Chunker --> Chroma
  Chunker --> Weaviate
  DomainAnalyzer --> Neo4j

  subgraph Retrieval["GraphRAG and hybrid retrieval"]
    GraphRetriever["Neo4j GraphRAG retriever"]
    KeywordRetriever["BM25 keyword retriever"]
    VectorRetriever["Vector retriever"]
    MetadataRetriever["Metadata and fact lookup"]
    EvidenceMerger["Evidence merge and dedupe"]
    EvidenceVerifier["EvidenceVerifierAgent"]
  end

  Neo4j --> GraphRetriever
  FTS --> KeywordRetriever
  OpenSearch --> KeywordRetriever
  Chroma --> VectorRetriever
  Weaviate --> VectorRetriever
  SQLite --> MetadataRetriever
  GraphRetriever --> EvidenceMerger
  KeywordRetriever --> EvidenceMerger
  VectorRetriever --> EvidenceMerger
  MetadataRetriever --> EvidenceMerger
  EvidenceMerger --> EvidenceVerifier

  subgraph Orchestration["LangGraph multi-agent orchestration"]
    ScenarioSelector["ScenarioSelectionAgent"]
    DependencyAudit["DependencyAuditAgent"]
    HarnessAgent["TestHarnessAgent"]
    WriterAgent["TestWriterAgent"]
    SyntaxAgent["SyntaxValidationAgent"]
    ExecutionAgent["TestExecutionAgent"]
    FailureAgent["FailureClassifierAgent"]
    SidecarAgent["JsonSidecarAgent"]
    DbAgent["DatabaseUpdateAgent"]
    ChatAgent["ChatAnswerAgent"]
    ReportAgent["ReportGeneratorAgent"]
  end

  Router --> EvidenceMerger
  EvidenceVerifier --> ScenarioSelector
  EvidenceVerifier --> ChatAgent
  ScenarioSelector --> DependencyAudit
  DependencyAudit --> HarnessAgent --> WriterAgent
  WriterAgent --> SidecarAgent
  WriterAgent --> SyntaxAgent --> ExecutionAgent --> FailureAgent
  FailureAgent --> SidecarAgent --> DbAgent --> ReportAgent

  subgraph Artifacts["Generated QA automation outputs"]
    Scenarios["Test scenarios"]
    TestCases["Structured test cases"]
    PytestFiles["pytest class files"]
    HarnessFiles["pytest.ini and conftest.py"]
    Sidecars["JSON sidecars"]
    RobotMap["Future Robot keyword mappings"]
    Reports["Markdown, JSON, CSV, Excel-ready reports"]
    Traceability["Coverage and traceability records"]
  end

  ScenarioSelector --> Scenarios --> TestCases
  HarnessAgent --> HarnessFiles
  WriterAgent --> PytestFiles
  SidecarAgent --> Sidecars
  ReportAgent --> Reports
  DbAgent --> Traceability
  WriterAgent -. future .-> RobotMap

  subgraph Execution["Execution targets"]
    Pytest["pytest now"]
    Robot["Robot Framework future"]
    Mocks["Local mocks"]
    Simulators["Simulators"]
    ProtocolAdapters["Modbus, MQTT, CAN, REST adapters"]
    Gateway["Embedded or industrial gateway"]
    Cloud["Cloud platform"]
    UI["Visualization UI future"]
  end

  PytestFiles --> Pytest
  HarnessFiles --> Pytest
  RobotMap -. future .-> Robot
  Pytest --> Mocks
  Pytest --> Simulators
  Pytest --> ProtocolAdapters
  ProtocolAdapters --> Gateway
  ProtocolAdapters --> Cloud
  Reports --> UI

  subgraph CICD["CI/CD and reporting"]
    Actions["GitHub Actions or Azure DevOps future"]
    TestReports["Execution reports"]
    CoverageDash["Coverage dashboard future"]
    Audit["Audit trail future"]
  end

  Pytest --> TestReports
  Robot -. future .-> TestReports
  TestReports --> Actions
  Traceability --> CoverageDash
  DbAgent --> Audit

  subgraph FutureBoundary["Future external agent boundary"]
    MCP["MCP tools and resources"]
  end

  API -. future .-> MCP
  MCP -. wraps stable services .-> Router
