# PostgreSQL is the authoritative metadata and BM25/FTS backend.
POSTGRES_DSN=postgresql+asyncpg://<user>:<pwd>@127.0.0.1:5432/<client>

# Neo4j graph projection.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your_neo_pwd>
NEO4J_DATABASE=neo4j
GRAPHRAG_REQUIRED=true

# Chroma vector index.
CHROMA_PATH=.multi_agentic_rag/chroma
CHROMA_COLLECTION=multi_agentic_rag_chunks

# Embeddings and reranking.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
HF_TOKEN=<your_huggingface_token>
RERANKER_PROVIDER=sentence_transformers
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Runtime directories.
MULTI_AGENTIC_RAG_HOME=.multi_agentic_rag
OBJECT_STORE_PATH=.multi_agentic_rag/objects
DOCUMENT_STORE_PATH=.multi_agentic_rag/documents
MANIFEST_STORE_PATH=.multi_agentic_rag/manifests

# Ingestion behavior.
CHUNK_SIZE=1200
CHUNK_OVERLAP=160
ENABLE_PDF_OCR=true
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Retrieval/logging.
BM25_BACKEND=postgres
LOG_LEVEL=INFO
