# Secret values only. Non-secret runtime settings live in `base_config.json`.

# Public OpenAI
OPENAI_API_KEY=

# Native Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<azure-resource>.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# PostgreSQL metadata, lexical BM25, and Alembic migrations.
POSTGRES_DSN=postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>

# Hugging Face and Gemini secrets, when used.
HF_TOKEN=
GEMINI_API_KEY=

# Neo4j graph projection.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Provider selection examples:
# REASONING_PROVIDER=openai
# EMBEDDING_PROVIDER=sentence_transformers
# RERANKER_PROVIDER=none
#
# REASONING_PROVIDER=azure_openai
# EMBEDDING_PROVIDER=azure_openai
# RERANKER_PROVIDER=azure_openai
#
# REASONING_PROVIDER=openai
# EMBEDDING_PROVIDER=azure_openai
# RERANKER_PROVIDER=azure_openai
