# ============================================================
# Multi-Agentic-RAG secrets and machine-local provider settings
# ============================================================

# ----------------------------
# Azure OpenAI reasoning
# ----------------------------
REASONING_PROVIDER=azure_openai

# Use the Azure OpenAI resource ROOT endpoint.
# Valid example:
# https://my-azure-openai-resource.openai.azure.com
#
# Do NOT append:
# /openai/v1
# /openai/deployments/...
# /chat/completions
# ?api-version=...
AZURE_OPENAI_ENDPOINT=https://<YOUR-AZURE-OPENAI-RESOURCE>.openai.azure.com

# Paste either KEY 1 or KEY 2 from the Azure resource.
AZURE_OPENAI_API_KEY=<YOUR-AZURE-OPENAI-API-KEY>

# Current repository-tested dated Azure API contract.
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Current repository uses the AzureOpenAI SDK path.
AZURE_OPENAI_REASONING_API_STYLE=chat_completions

# One targeted workflow repair after the controlled first run.
STRUCTURED_GENERATION_RETRY_COUNT=1

# ----------------------------
# Keep embeddings and reranking local
# ----------------------------
EMBEDDING_PROVIDER=sentence_transformers
RERANKER_PROVIDER=sentence_transformers

# ----------------------------
# PostgreSQL
# ----------------------------
POSTGRES_DSN=postgresql+asyncpg://marag:<YOUR-POSTGRES-PASSWORD>@127.0.0.1:5432/marag?ssl=disable

# ----------------------------
# Neo4j
# ----------------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<YOUR-NEO4J-PASSWORD>
NEO4J_DATABASE=marag

# ----------------------------
# Optional providers
# Leave empty when unused.
# ----------------------------
OPENAI_API_KEY=
HF_TOKEN=
GEMINI_API_KEY=
