# Secret values only. Non-secret runtime settings live in base_config.json.

# PostgreSQL metadata, lexical BM25, and Alembic migrations.
POSTGRES_DSN=postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>

# Reasoning providers. base_config.json selects the provider; these are secret values only.
OPENAI_API_KEY=<your_openai_api_key>
HF_TOKEN=<your_huggingface_token>
GEMINI_API_KEY=<your_gemini_api_key>

# Neo4j graph projection. URI, username, and database may also be configured in base_config.json.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your_neo4j_password>
NEO4J_DATABASE=neo4j
