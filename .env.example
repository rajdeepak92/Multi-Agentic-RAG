# Local runtime
MULTI_AGENTIC_RAG_HOME=.multi_agentic_rag
MULTI_AGENTIC_RAG_PROFILE=local
SQLITE_DB_PATH=.multi_agentic_rag/registry.db
OBJECT_STORE_PATH=.multi_agentic_rag/objects

# Graph store
# Create a local Neo4j Desktop DBMS, set the same password here, and start it.
# The dummy pytest automation flow can run without Neo4j, but graph-check and
# graph retrieval require a reachable Bolt endpoint.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
NEO4J_HOST=127.0.0.1
NEO4J_BOLT_PORT=7687
NEO4J_BROWSER_PORT=7474

# Optional helper script settings for scripts/start-neo4j-desktop.ps1
NEO4J_DESKTOP_EXE=
NEO4J_DBMS_HOME=
NEO4J_JAVA_HOME=
NEO4J_DESKTOP_DATA_PATH=
NEO4J_DUMPS_DIR=neo4j/dumps
NEO4J_IMPORT_DIR=neo4j/import

# Vector stores
# auto = use Weaviate when WEAVIATE_URL is set, otherwise use ChromaDB.
VECTOR_STORE_PROVIDER=auto
WEAVIATE_URL=
WEAVIATE_API_KEY=
WEAVIATE_COLLECTION=MultiAgenticRagChunk
WEAVIATE_HYBRID_ALPHA=0.65
CHROMA_PATH=.multi_agentic_rag/chroma

# Keyword index
KEYWORD_INDEX_ENABLED=true

# Embeddings and reranking
EMBEDDING_PROVIDER=hash
DEFAULT_EMBEDDING_MODEL=BAAI/bge-m3
DEFAULT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
HF_TOKEN=
HF_HOME=.cache/huggingface
HF_HUB_CACHE=.cache/huggingface/hub

# LLM provider, disabled by default for deterministic local flows.
# Use OpenAI for later LLM-backed routing, scenario reasoning, and debugging.
LLM_PROVIDER=none
DEFAULT_LLM_MODEL=gpt-5.5
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# PDF parsing
ENABLE_PDF_OCR=false
TESSERACT_CMD=

# API
API_HOST=127.0.0.1
API_PORT=8000

# MCP placeholder
MCP_ENABLED=false
MCP_TRANSPORT=stdio
